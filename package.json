{
  "name": "armor-arcade-release",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codex edition: eight browser games and a reproducible static release",
  "scripts": {
    "setup": "npm ci && npm --prefix MAGA-everything/02-code/armor-games ci",
    "build": "node tooling/build.mjs",
    "start": "node tooling/serve.mjs",
    "typecheck": "npm --prefix MAGA-everything/02-code/armor-games run typecheck --workspaces --if-present",
    "test": "node --test verification/tests/*.test.mjs hardest/regression.mjs MAGA-everything/02-code/armor-games/apps/swords-and-sandals/tests/progression.test.mjs MAGA-everything/02-code/armor-games/packages/shmup-core/tests/campaign.test.mjs tcg/prototype/tests/engine.test.cjs",
    "test:browser": "node tooling/verify-browser.mjs",
    "verify": "npm run typecheck && npm test && node hardest/validate.mjs && npm run build && npm run test:browser",
    "test:browser:smoke": "playwright test",
    "package": "npm run build && node tooling/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
